# Enable doco-cd to update itself when its own stack changes in the repository
SELF_UPDATE_ENABLED=true

# The strategy to use for self-updates
# https://doco.cd/latest/App-Settings/
SELF_UPDATE_STRATEGY=auto

# The path inside the container to the age private key used to decrypt the
# SOPS-encrypted files (mounted as a Docker secret in `compose.yaml`)
# https://doco.cd/latest/Advanced/Encryption/
SOPS_AGE_KEY_FILE=/run/secrets/sops_age_key

# The repositories to poll for changes, in YAML format (interval in seconds)
# https://doco.cd/latest/Poll-Settings/
POLL_CONFIG="
- url: https://github.com/ludelafo/m3w.ch.git
  reference: 82-add-doco-cd
  interval: 300
"
