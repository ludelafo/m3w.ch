@startnwdiag m3w-architecture
!include <office/Concepts/application_generic>
!include <office/Clouds/public_cloud>
!include <office/Devices/cell_phone_generic>
!include <office/Devices/device_laptop>
!include <office/Devices/device_tv>
!include <office/Devices/hard_disk>
!include <office/Devices/router>
!include <office/Devices/workstation>
!include <office/Servers/application_server>
!include <office/Servers/server_generic>
!include <office/Servers/virtual_application_server>

<style>
legend {
  HorizontalAlignment center
  FontSize 12
}
</style>

title m3w.ch architecture

legend
  **Legend**
  <#transparent,#transparent>|   <$public_cloud>   |   <$router>   |   <$server_generic>   |   <$device_laptop>   |   <$device_tv>   |   <$workstation>   |   <$application_generic>   |   <$virtual_application_server>   |   <$hard_disk>   |   <$cell_phone_generic>   |
  |   Internet   |   Router   |   Server   |   Laptop   |   Console   |   Workstation   |   Application   |   Container   |   Storage   |   Smartphone   |
endlegend

nwdiag {
  internet [shape = cloud,  description = "<$public_cloud>\nInternet"]

  router [address = "<External IP>, :25565, :51820/udp, :52570/tcp+udp",  description = "<$router>\nYallo Fiber Box 2\nyallo.m3w.ch"]

  nas [description = "<$server_generic>\nNAS\nnas.m3w.ch"]
  nas_1 [description = "<$server_generic>\nNAS\nnas.m3w.ch"]
  
  framework [description = "<$device_laptop>\nFramework\nframework.m3w.ch"]
  macbook_pro [description = "<$device_laptop>\nMacBook Pro\nmacbook.m3w.ch"]
  nintendo_wii [description = "<$device_tv>\nNintendo Wii\nwii.m3w.ch"]
  sony_ps5 [description = "<$device_tv>\nSony PlayStation 5\nps5.m3w.ch"]
  libreelec [description = "<$workstation>\nLibreELEC\nkodi.m3w.ch"]
  raspberry_pi [description = "<$server_generic>\nRaspberry Pi 3\nraspberry.m3w.ch"]
  raspberry_pi_1 [description = "<$server_generic>\nRaspberry Pi 3\nraspberry.m3w.ch"]

  storage_1 [description = "<$hard_disk>\nStorage\n(18 TB)"]
  storage_2 [description = "<$hard_disk>\nBackups\n(2 TB)"]

  adguard_home [description = "<$virtual_application_server>\nAdGuard Home\n(DNS and DHCP server)\nhttps://adguard.m3w.ch"]
  backrest [description = "<$virtual_application_server>\nBackrest ?\n(Backups)\nhttps://beszel.m3w.ch"]
  beszel [description = "<$virtual_application_server>\nBeszel\n(Hardware monitoring)\nhttps://beszel.m3w.ch"]
  gatus [description = "<$virtual_application_server>\nGatus\n(Service monitoring)\nhttps://gatus.m3w.ch"]
  glance [description = "<$virtual_application_server>\nGlance\n(Dashboard)\nhttps://m3w.ch"]
  navidrome [description = "<$virtual_application_server>\nNavidrome\n(Music server)\nhttps://navidrome.m3w.ch"]
  pocket_id [description = "<$virtual_application_server>\nPocket ID\n(Authentification)\nhttps://auth.m3w.ch"]
  qbittorrent [description = "<$virtual_application_server>\nqBittorrent\n(Torrent client)\nhttps://qbittorrent.m3w.ch"]
  samba [description = "<$virtual_application_server>\nSamba\n(Network shares)\nsmb://192.168.1.2"]
  syncthing_ludelafo [description = "<$virtual_application_server>\nSyncthing (ludelafo)\n(Files synchronisation)\nhttps://syncthing.ludelafo.m3w.ch"]
  syncthing_heaspery [description = "<$virtual_application_server>\nSyncthing (heaspery)\n(Files synchronisation)\nhttps://syncthing.heaspery.m3w.ch"]
  traefik [description = "<$virtual_application_server>\nTraefik\n(Reverse proxy)\nhttps://traefik.m3w.ch"];
  wg_easy [description = "<$virtual_application_server>\nWireguard Easy\n(VPN)\nhttps://vpn.m3w.ch"]
  tang [description = "<$application_generic>\nTang\n(LUKS unlocker)\nhttp://192.168.1.254"]

  group {
    description = "**Overview**"
  
    internet

    router

    nas
    framework
    macbook_pro
    nintendo_wii
    sony_ps5
    libreelec
    raspberry_pi

    storage_1
    storage_2
  }

  group {
    description = "**Raspberry Pi**"

    raspberry_pi_1

    tang
  }
  
  group {
    description = "**NAS**"

    internet -- router

    nas_1

    adguard_home
    backrest
    beszel
    gatus
    glance
    navidrome
    pocket_id
    qbittorrent
    samba
    syncthing_ludelafo
    syncthing_heaspery
    traefik
    wg_easy
  }

  // Overview
  network internal {
      address = "192.168.1.x/24"
      color = "LightGreen"
      router [address = "192.168.1.1"]

      nas [address = "192.168.1.2"]
      framework [address = "192.168.1.3"]
      macbook_pro [address = "192.168.1.4"]
      nintendo_wii [address = "192.168.1.7"]
  }

  network internal {
      address = "192.168.1.x/24"
      color = "LightGreen"

      sony_ps5 [address = "192.168.1.8"]
      libreelec [address = "192.168.1.9"]
      raspberry_pi [address = "192.168.1.254"]
  }

  network {
      color = "LightGreen"
      nas
      storage_1
      storage_2
  }

  // Raspberry Pi
  network host {
    color = "LightSkyBlue"
    raspberry_pi_1

    tang
  }

  // NAS
  network host {
    color = "LightPink"
    nas_1

    adguard_home [address = ":53/tcp+udp, :67/udp, :68/udp, ..."]
    samba [address = ":445, ..."]
    traefik [address = ":80, :443"]
  }

  network traefik_network {
    address = "<Docker internal network>"
    color = "LightPink"

    traefik
  }

  network traefik_network {
    address = "<Docker internal network>"
    color = "LightPink"

    pocket_id
    backrest
    beszel
  }

  network traefik_network {
    address = "<Docker internal network>"
    color = "LightPink"

    gatus
    glance
  }

  network traefik_network {
    address = "<Docker internal network>"
    color = "LightPink"

    navidrome
    qbittorrent
    wg_easy
  }

  network traefik_network {
    address = "<Docker internal network>"
    color = "LightPink"

    syncthing_ludelafo
    syncthing_heaspery
  }
}
@endnwdiag
