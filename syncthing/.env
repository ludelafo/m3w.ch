## Fully qualified domain names (FQDNs)
# The FQDN to access Syncthing
SYNCTHING_FQDN=syncthing.m3w.ch

## Container and Traefik names
# The name to use for Syncthing
SYNCTHING_CONTAINER_NAME=syncthing

## Ports
# The sync protocol port (TCP and UDP), unique per instance
SYNCTHING_PORT=22000

## User
# The PUID/PGID Syncthing runs as (owner of the synchronized files)
SYNCTHING_PUID=1000
SYNCTHING_PGID=1000

## OIDC
# The OIDC user to use for Syncthing
OIDC_USER=CHANGE_ME
