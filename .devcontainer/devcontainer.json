{
	"name": "m3w Development Container",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	// Set environment variables for the container
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"SOPS_AGE_KEY_FILE": "${containerWorkspaceFolder}/doco-cd/secrets/sops_age_key.txt"
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers-extra/features/sops:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "26"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"DavidAnson.vscode-markdownlint",
				"esbenp.prettier-vscode",
				"GitHub.copilot",
				"jebbs.plantuml",
				"redhat.ansible",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-french",
				"yzhang.markdown-all-in-one"
			]
		}
	},
	// Mount a volume to persist the Claude configuration across container rebuilds
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume"
	],
	"forwardPorts": [9090],
	"portsAttributes": {
		"9090": {
			"label": "PlantUML Server"
		}
	},
	// Execute the following command once the container is created
	"postCreateCommand": ".devcontainer/post-create.sh"
}
