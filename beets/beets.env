# The Acoustid API key (https://acoustid.org/api-key)
ACOUSTID_API_KEY=CHANGE_ME

# The Discogs user token (https://www.discogs.com/settings/developers)
DISCOGS_USER_TOKEN=CHANGE_ME

# The Fanart.tv API key (https://fanart.tv/get-an-api-key/)
FANARTTV_API_KEY=CHANGE_ME

# The Google API key (https://console.cloud.google.com/apis/credentials)
GOOGLE_API_KEY=CHANGE_ME

# The Last.fm API key (https://www.last.fm/api/account/create)
LASTFM_API_KEY=CHANGE_ME

# The ListenBrainz username (https://listenbrainz.org/settings/)
LISTENBRAINZ_USERNAME=CHANGE_ME

# The ListenBrainz token (https://listenbrainz.org/settings/)
LISTENBRAINZ_TOKEN=CHANGE_ME
